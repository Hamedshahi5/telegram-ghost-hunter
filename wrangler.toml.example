name = "ghost-hunter"
main = "src/index.ts"
compatibility_date = "2024-09-01"
compatibility_flags = ["nodejs_compat"]

# Non-secret configuration (booleans as strings)
[vars]
MONITOR_SELF = "false"
IGNORE_BOTS = "true"
PUBLIC_URL = "https://ghost-hunter.<your-subdomain>.workers.dev"

# Secrets — do NOT put real values here, use `wrangler secret put <NAME>` instead:
#   SESSION     -> GramJS StringSession for your Telegram user account
#   API_ID      -> Telegram app API ID
#   API_HASH    -> Telegram app API hash
#   AUTH_TOKEN  -> token used to log into the dashboard via ?key=

[[d1_databases]]
binding = "DB"
database_name = "ghost-hunter-db"
database_id = "<your-d1-database-id>"

[[durable_objects.bindings]]
name = "TG"
class_name = "TelegramDO"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["TelegramDO"]

[triggers]
crons = ["*/1 * * * *"]
